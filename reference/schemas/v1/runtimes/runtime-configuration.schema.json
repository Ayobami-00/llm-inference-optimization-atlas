{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ayobami-00.github.io/llm-inference-optimization-atlas/schemas/v1/runtimes/runtime-configuration.schema.json",
  "title": "Complete runtime configuration",
  "allOf": [
    { "$ref": "../common/artifact.schema.json" },
    {
      "type": "object",
      "required": ["runtime_build", "model", "hardware", "scheduling", "batching", "cache", "precision", "decoding", "parallelism", "memory", "threads", "environment"],
      "properties": {
        "kind": { "const": "RuntimeConfiguration" },
        "id": { "pattern": "^CFG[0-9]{3}$" },
        "runtime_build": { "$ref": "../common/reference.schema.json" },
        "model": { "$ref": "../common/reference.schema.json" },
        "hardware": { "$ref": "../common/reference.schema.json" },
        "scheduling": { "type": "object" },
        "batching": { "type": "object" },
        "cache": { "type": "object" },
        "precision": { "type": "object" },
        "decoding": { "type": "object" },
        "parallelism": { "type": "object" },
        "communication": { "type": "object" },
        "memory": { "type": "object" },
        "threads": { "type": "object" },
        "api": { "type": "object" },
        "environment": { "type": "array", "items": { "type": "object", "required": ["name", "value", "redacted"], "properties": { "name": { "type": "string" }, "value": { "type": "string" }, "redacted": { "type": "boolean" } }, "additionalProperties": false } }
      }
    }
  ],
  "unevaluatedProperties": false
}
