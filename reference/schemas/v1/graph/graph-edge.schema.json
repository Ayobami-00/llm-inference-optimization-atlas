{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ayobami-00.github.io/llm-inference-optimization-atlas/schemas/v1/graph/graph-edge.schema.json",
  "title": "Evidence graph edge",
  "type": "object",
  "required": ["id", "source", "target", "relation", "assertion_level", "evidence", "scope", "confidence", "provenance"],
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string" },
    "target": { "type": "string" },
    "relation": { "enum": ["INSTANCE_OF", "HAS_CHARACTERISTIC", "USES_TRAFFIC_REGIME", "HAS_QUALITY_CONTRACT", "HAS_SLO", "USES_MODEL", "EXECUTED_ON", "USES_RUNTIME", "USES_CONFIGURATION", "SUGGESTS", "ASSOCIATED_WITH", "HYPOTHESIZED_TO_CAUSE", "VALIDATED_AS_BOTTLENECK", "TARGETS", "TESTS", "HAS_RUN", "COMPARES", "PRODUCES", "SUPPORTS", "CONTRADICTS", "REPLICATES", "IMPROVES", "DEGRADES", "NO_SIGNIFICANT_EFFECT", "INTERACTS_WITH", "APPLIES_UNDER", "LIMITED_BY", "JUSTIFIES", "REJECTS", "CITES", "SUPERSEDES", "DERIVED_FROM"] },
    "assertion_level": { "enum": ["structural", "theoretical", "hypothetical", "observational", "experimentally_supported", "replicated"] },
    "evidence": { "type": "array", "items": { "$ref": "../common/reference.schema.json" } },
    "scope": { "type": "object" },
    "confidence": { "enum": ["none", "low", "moderate", "high"] },
    "provenance": { "type": "object", "required": ["source_path"], "properties": { "source_path": { "type": "string" }, "derived": { "type": "boolean" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
