{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ayobami-00.github.io/llm-inference-optimization-atlas/schemas/v1/studies/decision.schema.json",
  "title": "Deployment decision",
  "allOf": [
    {
      "$ref": "../common/artifact.schema.json"
    },
    {
      "type": "object",
      "required": [
        "study",
        "outcome",
        "pareto_rationale",
        "supporting_findings",
        "rejected_alternatives",
        "caveats",
        "revisit_conditions"
      ],
      "properties": {
        "kind": {
          "const": "DeploymentDecision"
        },
        "id": {
          "pattern": "^DEC[0-9]{4}$"
        },
        "study": {
          "$ref": "../common/reference.schema.json"
        },
        "outcome": {
          "enum": [
            "recommended",
            "no_recommendation",
            "deferred"
          ]
        },
        "selected_configuration": {
          "$ref": "../common/reference.schema.json"
        },
        "pareto_rationale": {
          "type": "string"
        },
        "operating_envelope": {
          "type": "object"
        },
        "supporting_findings": {
          "type": "array",
          "items": {
            "$ref": "../common/reference.schema.json"
          }
        },
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "configuration",
              "reason"
            ],
            "properties": {
              "configuration": {
                "$ref": "../common/reference.schema.json"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "caveats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "revisit_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "recommended"
          }
        }
      },
      "then": {
        "required": [
          "selected_configuration"
        ]
      },
      "else": {
        "not": {
          "required": [
            "selected_configuration"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
