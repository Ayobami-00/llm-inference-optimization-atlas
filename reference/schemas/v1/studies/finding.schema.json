{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ayobami-00.github.io/llm-inference-optimization-atlas/schemas/v1/studies/finding.schema.json",
  "title": "Evidence-backed finding",
  "allOf": [
    {
      "$ref": "../common/artifact.schema.json"
    },
    {
      "type": "object",
      "required": [
        "statement",
        "scope",
        "observation",
        "mechanism",
        "baseline",
        "intervention",
        "effects",
        "works_when",
        "stops_working_when",
        "interactions",
        "limitations",
        "evidence",
        "evidence_confidence",
        "transferability",
        "claim_status"
      ],
      "properties": {
        "kind": {
          "const": "Finding"
        },
        "id": {
          "pattern": "^F[0-9]{4}$"
        },
        "statement": {
          "type": "string"
        },
        "scope": {
          "type": "object",
          "required": [
            "workload",
            "model",
            "runtime",
            "hardware",
            "traffic"
          ],
          "properties": {
            "workload": {
              "$ref": "../common/reference.schema.json"
            },
            "model": {
              "$ref": "../common/reference.schema.json"
            },
            "runtime": {
              "$ref": "../common/reference.schema.json"
            },
            "hardware": {
              "$ref": "../common/reference.schema.json"
            },
            "traffic": {
              "type": "array",
              "items": {
                "$ref": "../common/reference.schema.json"
              }
            }
          },
          "additionalProperties": false
        },
        "observation": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "baseline": {
          "$ref": "../common/reference.schema.json"
        },
        "intervention": {
          "$ref": "../common/reference.schema.json"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "works_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stops_working_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "comparisons",
            "runs"
          ],
          "properties": {
            "comparisons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "../common/reference.schema.json"
              }
            },
            "runs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "../common/reference.schema.json"
              }
            }
          },
          "additionalProperties": false
        },
        "mechanism_sources": {
          "type": "array",
          "items": {
            "$ref": "../common/reference.schema.json"
          }
        },
        "evidence_confidence": {
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "transferability": {
          "enum": [
            "exact_setup",
            "same_hardware_class",
            "cross_hardware",
            "cross_runtime",
            "cross_model",
            "cross_workload"
          ]
        },
        "claim_status": {
          "enum": [
            "proposed",
            "reviewed",
            "supported",
            "inconclusive",
            "contradicted",
            "superseded",
            "generalized"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
