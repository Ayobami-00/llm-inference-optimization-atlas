{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ayobami-00.github.io/llm-inference-optimization-atlas/schemas/v1/studies/comparison.schema.json",
  "title": "Statistical comparison",
  "allOf": [
    {
      "$ref": "../common/artifact.schema.json"
    },
    {
      "type": "object",
      "required": [
        "experiment",
        "baseline_runs",
        "candidate_runs",
        "changed_axes",
        "compatibility",
        "method",
        "effects",
        "quality_eligible",
        "slo_eligible",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "Comparison"
        },
        "id": {
          "pattern": "^CMP[0-9]{4}$"
        },
        "experiment": {
          "$ref": "../common/reference.schema.json"
        },
        "contrast": {
          "type": "object",
          "required": [
            "id",
            "baseline",
            "candidate"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "baseline": {
              "$ref": "../common/reference.schema.json"
            },
            "candidate": {
              "$ref": "../common/reference.schema.json"
            }
          },
          "additionalProperties": false
        },
        "baseline_runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../common/reference.schema.json"
          }
        },
        "candidate_runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../common/reference.schema.json"
          }
        },
        "changed_axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "compatibility": {
          "type": "object",
          "required": [
            "passed",
            "checks"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "method": {
          "type": "object",
          "required": [
            "paired"
          ],
          "properties": {
            "paired": {
              "type": "boolean"
            },
            "inference": {
              "enum": [
                "interval_estimated",
                "descriptive_only"
              ]
            },
            "independent_units": {
              "type": "integer",
              "minimum": 1
            },
            "confidence_level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "bootstrap_resamples": {
              "type": "integer",
              "minimum": 1
            },
            "bootstrap_seed": {
              "type": "integer"
            },
            "pairing_keys": {
              "type": "array",
              "items": {
                "enum": [
                  "replicate",
                  "seed"
                ]
              },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "effect_metrics": {
              "description": "Ordered effect-metric plan frozen from the experiment when the comparison was generated.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "../common/reference.schema.json"
              }
            }
          },
          "additionalProperties": false
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "metric",
              "baseline",
              "candidate",
              "absolute",
              "relative",
              "confidence_interval",
              "unit"
            ],
            "properties": {
              "metric": {
                "$ref": "../common/reference.schema.json"
              },
              "baseline": {
                "type": "number"
              },
              "candidate": {
                "type": "number"
              },
              "absolute": {
                "type": "number"
              },
              "relative": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Relative effect, or null when the baseline denominator is zero or otherwise unsuitable for a relative effect."
              },
              "confidence_interval": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "unit": {
                "type": "string"
              },
              "scope": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "quality_eligible": {
          "type": "boolean"
        },
        "slo_eligible": {
          "type": "boolean"
        },
        "result": {
            "enum": [
              "improvement",
              "degradation",
              "no_significant_effect",
              "inconclusive",
              "mixed",
              "invalid"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "compatibility"
        ],
        "properties": {
          "compatibility": {
            "required": [
              "passed"
            ],
            "properties": {
              "passed": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "invalid"
          },
          "quality_eligible": {
            "const": false
          },
          "slo_eligible": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "not": {
              "const": "invalid"
            }
          }
        }
      },
      "then": {
        "properties": {
          "compatibility": {
            "properties": {
              "passed": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
